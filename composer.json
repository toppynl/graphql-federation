  "description": "GraphQL Federation v2 subgraph support for webonyx/graphql-php",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "webonyx/graphql-php": "^15.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
